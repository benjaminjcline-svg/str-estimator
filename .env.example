# Payments mode: "waitlist" (default) or "live". When waitlist, CTAs collect emails; when live, full purchase flow.
# Next.config copies this to NEXT_PUBLIC_PAYMENTS_MODE at build time for client-side checks.
PAYMENTS_MODE=waitlist

# Stripe (get keys from https://dashboard.stripe.com/apikeys). Only used when PAYMENTS_MODE=live.
STRIPE_SECRET_KEY=sk_test_xxxxx

# Redis - for report storage and waitlist. Use either set of names (Vercel KV uses KV_*).
# From Vercel Storage / Upstash: copy KV_REST_API_URL + KV_REST_API_TOKEN from the Quickstart.
# Or from upstash.com: UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxx

# Test accounts - these emails bypass payment (comma-separated)
# Use for internal testing and QA
TEST_BYPASS_EMAILS=test@str-estimator.com,demo@example.com

# Your domain (for sitemap, robots, Open Graph) - update when you have a custom domain
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Geoapify - for address autocomplete (free at myprojects.geoapify.com, 3k requests/day)
# NEXT_PUBLIC_GEOAPIFY_API_KEY=your_api_key

# Unsplash API - for dynamic background images based on address (free at unsplash.com/developers)
# UNSPLASH_ACCESS_KEY=your_access_key

# Optional: OpenAI API key for STR Market Brief expert analysis (platform.openai.com)
# When set, /learn/brief adds LLM-generated analysis for SEO
# OPENAI_API_KEY=sk-xxxxx

# Optional: Secret for cron endpoint (protects /api/cron/fetch-brief)
# CRON_SECRET=your_random_secret

# Admin token for waitlist CSV export (GET /api/admin/waitlist?token=... or Authorization: Bearer <token>)
# ADMIN_TOKEN=your_random_secret

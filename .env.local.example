# Copy to .env.local and fill in your values

# Stripe (required for payment - get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxx

# Test accounts - use these emails to bypass payment during development
# Example: test@str-estimator.com will skip Stripe and go straight to the report
TEST_BYPASS_EMAILS=test@str-estimator.com,demo@example.com

# Your domain (for sitemap, robots, Open Graph) - set when deploying
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
